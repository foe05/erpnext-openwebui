# ERPNext-Zugang (Service-Account). Diese Datei ist nur eine Vorlage.
# Kopiere sie zu .env und trage echte Werte ein — .env wird NICHT committet.

# Basis-URL der ERPNext-Instanz (ohne abschließenden Slash)
ERPNEXT_URL=https://deine-instanz.frappe.cloud

# API-Key/Secret des Service-Accounts (User > API Access > Generate Keys)
ERPNEXT_API_KEY=
ERPNEXT_API_SECRET=

# Optional: Standard-Seitenlänge für Listen/Suche
ERPNEXT_DEFAULT_LIMIT=20

# Optional: Timeout für REST-Aufrufe in Sekunden
ERPNEXT_TIMEOUT=30
