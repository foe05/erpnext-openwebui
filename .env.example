# ERPNext-Zugang (Service-Account). Diese Datei ist nur eine Vorlage.
# Kopiere sie zu .env und trage echte Werte ein — .env wird NICHT committet.

# Basis-URL der ERPNext-Instanz (ohne abschließenden Slash)
ERPNEXT_URL=https://deine-instanz.frappe.cloud

# API-Key/Secret des Service-Accounts (User > API Access > Generate Keys)
ERPNEXT_API_KEY=
ERPNEXT_API_SECRET=

# Optional: Standard-Seitenlänge für Listen/Suche
ERPNEXT_DEFAULT_LIMIT=20

# Optional: Timeout für REST-Aufrufe in Sekunden
ERPNEXT_TIMEOUT=30

# Schlüssel, mit dem mcpo seinen HTTP-Endpunkt schützt (--api-key).
# Denselben Wert in OpenWebUI als Auth/Bearer des Tool-Servers eintragen.
MCPO_API_KEY=

# --- Selling-Config (Phase 1): Vorbedingungen für korrekte Beträge/Belege ---
# Fehlen sie, laufen die Verben trotzdem, warnen aber bzw. brechen klar ab.

# Employee-ID für zeit_erfassen (Timesheet gehört einem Mitarbeiter)
ERPNEXT_DEFAULT_EMPLOYEE=

# Generisches Service-Item (Hybrid-Fallback für Angebot/Rechnung, wenn kein
# Katalog-Artikel passt)
ERPNEXT_GENERIC_SERVICE_ITEM=

# Standard-Steuertemplate fürs Angebot/Rechnung (z. B. "Deutschland 19%")
ERPNEXT_DEFAULT_TAX_TEMPLATE=

# Standard-Verkaufspreisliste (Preis-Default für Angebotspositionen)
ERPNEXT_DEFAULT_PRICE_LIST=

# Default-Zuständiger (User/E-Mail) für Erinnerungen (ToDo allocated_to)
ERPNEXT_DEFAULT_USER=
